# ==========================================
# Mini Kanban Board - Environment Configuration
# ==========================================

# Port and host for the server (optional, defaults: PORT=8000, HOST=0.0.0.0)
PORT=8000
HOST=0.0.0.0

# Database Configuration (Database-Agnostic)
# Supports any database supported by SQLAlchemy (SQLite, PostgreSQL, MySQL, etc.)

# Option 1: SQLite local file (default)
DATABASE_URL=sqlite:///kanban.db

# Option 2: SQLite in-memory (useful for ephemeral testing or CI)
# DATABASE_URL=sqlite:///:memory:

# Option 3: PostgreSQL (production or staging)
# DATABASE_URL=postgresql://user:password@localhost:5432/kanban_db
# (Also accepts legacy postgres:// URLs and normalizes automatically)

# Database Connection Pool Settings (for non-SQLite databases such as PostgreSQL)
# DB_POOL_RECYCLE=300

# Security (JWT secret key for user sessions)
JWT_SECRET_KEY=mini-kanban-secret-jwt-key-2026-super-secure
